# PostgreSQL connection used by SQLAlchemy and Alembic.
DATABASE_URL=postgresql+psycopg://offertrap_user:change-me@localhost:5432/offertrap

# Use a long, random secret in deployed environments.
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Single administrator credentials for the current moderation workflow.
ADMIN_USERNAME=moderator
ADMIN_PASSWORD=replace-with-a-unique-password

# Backblaze B2 S3-compatible API credentials.
B2_REGION=us-west-004
B2_APPLICATION_KEY_ID=your-b2-application-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=offertrap-evidence
B2_PRESIGNED_URL_TTL_SECONDS=600

# Comma-separated frontend origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:5173

# Points are credited only when a report is approved by an administrator.
REWARD_POINTS_PER_APPROVED_REPORT=100
LOG_LEVEL=INFO
